impl<T, const N: usize> Distribution<[T; N]> for StandardUniform where StandardUniform: Distribution<T> {
 fn sample(&self, rng: &mut R) -> [T; N] {
 array::from_fn(| _ | rng.random())
 }
 
}

impl<T> Distribution<Wrapping<T>> for StandardUniform where StandardUniform: Distribution<T> {
 fn sample(&self, rng: &mut R) -> Wrapping<T> {
 Wrapping(rng.random())
 }
 
}

